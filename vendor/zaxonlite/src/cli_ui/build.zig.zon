            .hash = "vaxis-0.6.0-BWNV_DsLCgCcKudOoFkyrSgjxUeLAOSf1LxwezEeVieH",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "ui.zig",
        "term.zig",
        "editor.zig",
        "history.zig",
        "highlight.zig",
        "view.zig",
        "table.zig",
        "reader.zig",
        "pager.zig",
        "tests.zig",
        "README.md",
        "LICENSE",
    },
}
