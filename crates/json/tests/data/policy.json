{
  "default_action": "ALLOW",
  "waf": true,
  "thresholds": {
    "challenge_at": 20,
    "deny_at": 60,
    "bits_step": 4
  },
  "ip_rules": {
    "203.0.0.0/24": "CHALLENGE",
    "203.0.1.0/24": "DENY",
    "203.0.2.0/24": "CHALLENGE",
    "203.0.3.0/24": "DENY",
