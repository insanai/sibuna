  "rules": [
    {
      "name": "block-bad-worker",
      "headers": {
        "CF-Worker": ".*",
        "X-Forwarded-Host": "^evil\\."
      },
      "action": "DENY"
    },
    {
      "name": "protect-checkout",
      "path": "/api/checkout/1/*",
      "action": "CHALLENGE",
      "challenge": {
        "difficulty": 9,
        "algorithm": "hashcash"
      },
      "limits": {
        "rate": 20,
        "window_seconds": 60,
        "ban_seconds": 300
      }
    },
    {
      "name": "protect-login",
      "user_agent_regex": "(?i)headless|phantom|selenium",
      "action": "WEIGH",
      "weight": 12
    },
    {
      "name": "api-rate",
      "cidrs": [
        "10.0.0.0/8",
        "192.168.0.0/16",
        "2001:db8::/32"
      ],
      "action": "ALLOW"
    },
    {
