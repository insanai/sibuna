"fontsize=9, fontcolor=\"#172033\", color=\"#1e40af\", "
"fillcolor=\"#eff6ff\", penwidth=1.1, width=1.6, margin=\"0.1,0.05\"];\n"
"  edge [color=\"#64748b\", fontname=\"Helvetica\", fontsize=8, "
"fontcolor=\"#475569\", arrowsize=0.6, penwidth=1.1];\n"
"  browser [label=\"Browser\\nconsole interface\\n(WebAssembly)\", "
"color=\"#6d28d9\", fillcolor=\"#f5f3ff\"];\n"
"  server [label=\"Console server\\nbounded listener\", color=\"#172033\", "
"fillcolor=\"#ffffff\", penwidth=1.8, height=0.6];\n"
"  plane [label=\"Data plane\\ncounters and stats\\n(read only)\", "
"color=\"#15803d\", fillcolor=\"#f0fdf4\"];\n"
