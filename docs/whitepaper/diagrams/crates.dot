digraph crates {
  graph [rankdir=TB, bgcolor="transparent", newrank=true, nodesep=0.16, ranksep=0.42, pad=0.2, fontname="Helvetica", fontsize=9, fontcolor="#55665e"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, fontcolor="#20352f", color="#6a7c73", fillcolor="#fffffc", penwidth=0.9, height=0.32, width=0.6, margin="0.12,0.05"];
  edge [color="#6a7c73", arrowsize=0.55, penwidth=0.9];

  sibuna [label="sibuna (daemon)", color="#176a4b", fillcolor="#e7eee4", fontcolor="#0c402c", penwidth=1.4];
  wasm [label="browser prover (WebAssembly)", color="#176a4b", fillcolor="#e7eee4", fontcolor="#0c402c"];
  storage [label="storage (sqlx)", color="#8f5512", fillcolor="#fbf4e4", shape=cylinder, style=filled];
  policy; challenge; net; core;
  subgraph cluster_reusable {
    label="reusable libraries, no third-party code"; labelloc=b; labeljust=r; style="dashed,rounded,filled"; color="#c3cec0"; fillcolor="#f7f6f1"; margin=10;
    geoip; inflate; cidr; json; patterns; http; encoding; crypto; pow; store;
  }
  { rank=same; wasm; sibuna; }
  { rank=same; policy; core; net; challenge; }
  { rank=same; geoip; cidr; json; patterns; http; pow; }
  { rank=same; inflate; encoding; crypto; store; }

  sibuna -> policy [color="#176a4b", penwidth=1.2]; sibuna -> storage [color="#176a4b", penwidth=1.2];
  sibuna -> net [color="#176a4b", penwidth=1.2]; sibuna -> challenge [color="#176a4b", penwidth=1.2];
  storage -> policy; storage -> core;
  policy -> cidr; policy -> json; policy -> patterns; policy -> core;
  core -> net [dir=back];
  net -> http;
  http -> encoding; http -> crypto;
  geoip -> inflate; geoip -> crypto;
  challenge -> encoding; challenge -> crypto; challenge -> pow; challenge -> store;
  pow -> crypto;
  wasm -> pow [color="#176a4b"];
}
