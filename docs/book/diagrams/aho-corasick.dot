digraph aho_corasick {
  // algorithms.rst: trie states and failure edges for two signatures. A goto edge reads
  // the letters on it; a dashed failure edge is taken when the next byte has none.
  graph [rankdir=LR, bgcolor="transparent", pad=0.1, nodesep=0.3, ranksep=0.35];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, fontcolor="#20352f", color="#6a7c73", fillcolor="#fffffc", penwidth=0.7, margin="0.1,0.05", height=0.3, width=0.4];
  edge [fontname="Courier-Bold", fontsize=8.5, fontcolor="#176a4b", color="#6a7c73", arrowsize=0.6, penwidth=0.7];

  root [label=<<B>Root (0)</B>>];
  g [label="G"];
  gp [label="GP"];
  gptbot [label=<GPTBot<BR/><FONT POINT-SIZE="8" COLOR="#55665e">match</FONT>>, color="#a3432b", fillcolor="#f9e9e3", fontcolor="#a3432b"];
  c [label="C"];
  cl [label="Cl"];
  claudebot [label=<ClaudeBot<BR/><FONT POINT-SIZE="8" COLOR="#55665e">match</FONT>>, color="#a3432b", fillcolor="#f9e9e3", fontcolor="#a3432b"];

  root -> g [label="g"];
  g -> gp [label="p"];
  gp -> gptbot [label="tbot"];
  root -> c [label="c"];
  c -> cl [label="l"];
  cl -> claudebot [label="audebot"];

  // A failure edge points back to the root; dir=back keeps it in the ranking.
  edge [style=dashed, color="#8f5512", fontname="Helvetica", fontsize=8, fontcolor="#8f5512", dir=back];
  root -> gp [label="fail"];
  root -> cl [label="fail"];
}
