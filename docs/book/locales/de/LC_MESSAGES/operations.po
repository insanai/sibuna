"  (\n"
"    actor(\"old\", \"Alter Prozess\"),\n"
"    actor(\"new\", \"Ersatzprozess\", kind: \"accent\"),\n"
"  ),\n"
"  (\n"
"    msg(\"new\", \"old\", \"`HELLO`\"),\n"
"    msg(\"old\", \"new\", \"`LISTENERS` mit `SCM_RIGHTS`\"),\n"
"    msg(\"new\", \"old\", \"`READY`\", accent: true, note: \"Niemand "
"liest UDP; der Kernel hält die Datagramme\"),\n"
"    act(\"old\", \"UDP pausieren, TCP weiter annehmen\"),\n"
