"                max_flows_per_ip: 64, max_flows: 60000,\n"
"                auto_ban: { strikes: 100, window: \"10s\", ban: \"15m\" "
"},\n"
"            },\n"
"            game: {\n"
"                proto: \"udp\", binds: [\"192.0.2.10:7777\"],\n"
"                udp_defense: { mode: \"rate_limit\", threshold_pps: 500, "
"total_pps: 300000 },\n"
"            },\n"
"        },\n"
"        backends: {\n"
"            shop: { servers: [\"10.0.0.11:8080\", \"10.0.0.12:8080\"] },\n"
