"  VALUES ('p1', 'protect', 10, '/checkout/*', 'challenge', 20, 'posw', "
"'{}', '[]', 0, 1,\n"
"  unixepoch(), unixepoch());\n"
"INSERT INTO ip_reputation (ip_or_cidr, reputation_score, banned_until, "
"trigger_rule, hits, last_seen)\n"
