"Connection\n"
"    }\n"
"    let mut framing = fields.length.map_or(Framing::UntilClose, "
"Framing::Length);\n"
"    if head_request || status / 100 == 1 || status == 204 || status == 304 "
"{\n"
"        framing = Framing::None;\n"
"    } else if fields.encoded {\n"
"        framing =\n"
"            if fields.chunked { Framing::Chunked } else { "
"Framing::UntilClose };\n"
"    }\n"
"    let mut keep_alive = fields.keep_alive;\n"
"    if framing == Framing::UntilClose || fields.closing {\n"
"        keep_alive = false;\n"
