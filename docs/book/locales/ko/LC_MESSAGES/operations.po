#: ../../operations.rst:278
msgid ""
"The path of a flow through the edge. Only HTTP requests meet the "
"firewall, and a route can skip it."
msgstr "엣지를 지나는 플로의 경로. HTTP 요청만 방화벽을 만나며, 경로는 방화벽을 건너뛸 수 있습니다."

#: ../../operations.rst:281
msgid "A first topology"
msgstr "첫 토폴로지"

#: ../../operations.rst:284
msgid "This module forwards one TCP port and one UDP port."
msgstr "이 모듈은 TCP 포트 하나와 UDP 포트 하나를 전달합니다."

#: ../../operations.rst:286
msgid ""
"fn edge() -> Map<Value> {\n"
"    return {\n"
"        global: { max_flows: 8192 },\n"
"        frontends: {\n"
"            ssh: { proto: \"tcp\", binds: [\"0.0.0.0:2222\"], "
"session_timeout: \"1h\" },\n"
"            dns: {\n"
"                proto: \"udp\", binds: [\"192.0.2.10:53\"], "
"session_timeout: \"10s\",\n"
"                udp_defense: { mode: \"rate_limit\", threshold_pps: 200 "
"},\n"
"            },\n"
"        },\n"
"        backends: {\n"
"            forge_ssh: { mode: \"tcp\", servers: [\n"
"                { name: \"a\", addr: \"10.20.0.8:22\", weight: 2, "
"max_flows: 100 },\n"
"                { name: \"b\", addr: \"10.20.0.9:22\", weight: 1, "
"max_flows: 50 },\n"
"            ] },\n"
"            nameservers: {\n"
"                mode: \"udp\", balance: { kind: \"bounded_maglev\" },\n"
