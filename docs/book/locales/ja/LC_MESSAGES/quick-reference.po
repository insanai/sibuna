#: ../../quick-reference.rst:1
msgid "Part XIII: Quick Reference Card"
msgstr "第XIII部：早見表"

#: ../../quick-reference.rst:4
msgid ""
"Keep beside a terminal: build, run, configure, route, observe, and "
"diagnose. Part XII holds the full tables; this card holds what an "
"operator types."
msgstr ""
"ターミナルのそばに置いてください。ビルド、実行、設定、ルーティング、観測、診断を扱います。完全な表は第XII部にあります。この早見表には、運用者が入力するものをまとめています。"

#: ../../quick-reference.rst:6
msgid "Build"
msgstr "ビルド"

#: ../../quick-reference.rst:9
msgid ""
"cargo build --release -p sibuna                          # daemon + "
"SQLite + console + JLV + ACME\n"
"cargo build --release -p sibuna --no-default-features    # in-memory, no "
"external crate\n"
"cargo build --release -p sibuna --features postgres-tls  # shared "
"PostgreSQL clusters\n"
"rustup target add wasm32-unknown-unknown   # or set SIBUNA_POW_WASM / "
"SIBUNA_CONSOLE_WASM\n"
"cargo test            # unit, live daemon, storage and console tests\n"
"cargo clippy --all-targets && cargo fmt --check\n"
"cargo xtask check     # 70-line / 1,408-line / 99-column gate\n"
"cargo xtask browser   # headless Chromium checks\n"
"cargo xtask bench product   # whole products under wrk -> "
"benchmarks/results/\n"
"guidedog build        # this book (guidedog dsc: the SID records)"
msgstr ""
"cargo build --release -p sibuna                          # "
"デーモン+SQLite+コンソール+JLV+ACME\n"
"cargo build --release -p sibuna --no-default-features    # "
"インメモリ、外部クレートなし\n"
"cargo build --release -p sibuna --features postgres-tls  # "
"共有PostgreSQLのクラスター\n"
"rustup target add wasm32-unknown-unknown   # またはSIBUNA_POW_WASM / "
"SIBUNA_CONSOLE_WASM\n"
"cargo test            # 単体、稼働中のデーモン、ストレージ、コンソールのテスト\n"
"cargo clippy --all-targets && cargo fmt --check\n"
"cargo xtask check     # 70行 / 1,408行 / 99桁の検査\n"
"cargo xtask browser   # ヘッドレスChromiumでの検査\n"
"cargo xtask bench product   # wrkによる製品全体の測定 -> benchmarks/results/\n"
"guidedog build        # 本書（guidedog dsc：SIDの記録）"

#: ../../quick-reference.rst:22
msgid "Run"
msgstr "実行"

#: ../../quick-reference.rst:25
msgid ""
"# Shield (default): PoW + WAF, proxy to :3000\n"
"sibuna -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Gate: PoW only\n"
"sibuna --gate -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Forward auth behind Nginx/Caddy (trusts X-Forwarded-For)\n"
"sibuna -m forward_auth --host 127.0.0.1 -p 8080 -s /etc/sibuna/secret\n"
"# Edge: persistent policies, reputation, forensics in <dir>/sibuna.db\n"
"sibuna -D /var/lib/sibuna -s /etc/sibuna/secret\n"
"# JA4 from a trusted ingress (Cloudflare's header; nginx module: x-ja4; "
"ATS: ja4)\n"
"sibuna --ja4-header cf-ja4 --trust-forwarded -p 8080 -u 3000 -s "
"/etc/sibuna/secret\n"
"# Cluster member: shared PostgreSQL, unique node id\n"
"sibuna --database-url-file /etc/sibuna/database-url --cluster-node 1 -s "
"/etc/sibuna/secret\n"
"head -c 32 /dev/urandom | xxd -p -c 64 > /etc/sibuna/secret"
msgstr ""
"# Shield（標準）：PoW + WAF、:3000へプロキシ\n"
"sibuna -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Gate：PoWのみ\n"
"sibuna --gate -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Nginx/Caddyの後ろでforward auth（X-Forwarded-Forを信頼する）\n"
"sibuna -m forward_auth --host 127.0.0.1 -p 8080 -s /etc/sibuna/secret\n"
"# Edge：<dir>/sibuna.dbに永続的なポリシー、レピュテーション、フォレンジック\n"
"sibuna -D /var/lib/sibuna -s /etc/sibuna/secret\n"
"# 信頼できるイングレスからのJA4（Cloudflareのヘッダー。nginxモジュール：x-ja4、ATS：ja4）\n"
"sibuna --ja4-header cf-ja4 --trust-forwarded -p 8080 -u 3000 -s "
"/etc/sibuna/secret\n"
"# クラスターのメンバー：共有PostgreSQL、一意なノードID\n"
"sibuna --database-url-file /etc/sibuna/database-url --cluster-node 1 -s "
"/etc/sibuna/secret\n"
"head -c 32 /dev/urandom | xxd -p -c 64 > /etc/sibuna/secret"

#: ../../quick-reference.rst:41
msgid "Edge load balancer"
msgstr "エッジのロードバランサー"

#: ../../quick-reference.rst:44
msgid ""
"sibuna lb --bind :8080 --server 10.0.0.1:80 --server 10.0.0.2:80   # no "
"file needed\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --print-config > edge.jlv\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --firewall shield --health "
"/healthz --admin /run/sibuna/edge.sock --access-log stdout\n"
"sibuna lb --proto tcp --bind :2222 --server 10.0.0.8:22\n"
"sibuna lb --proto udp --bind 192.0.2.10:53 --server 10.0.0.53:53       # "
"UDP binds a specific IP\n"
"sibuna lb --tls auto --domain example.org --server 10.0.0.1:80     # "
"automatic HTTPS (ACME)\n"
"sibuna check -f edge.jlv           # or edge.json: validate topology, "
"certificates, CA files\n"
"sibuna --config-file edge.jlv      # serve TCP, UDP and HTTP frontends\n"
"kill -HUP \"$(pidof sibuna)\"        # reload routes, policy and "
"certificates in place\n"
"sibuna ctl /run/sibuna/edge.sock show servers                      # "
"needs global.admin_socket\n"
"sibuna ctl /run/sibuna/edge.sock show stats                        # the "
"Prometheus text of the edge\n"
"sibuna ctl /run/sibuna/edge.sock help                              # "
"every command\n"
"/opt/sibuna/new/sibuna --config-file edge.jlv   # with "
"global.upgrade_socket: replaces the running daemon, no connection lost "
"(Linux)\n"
"sibuna lb --tls auto --domain localhost --server 10.0.0.1:80       # the "
"same from the local authority\n"
"sibuna lb --tls auto --domain staging.example.org --acme-issuer internal "
"--server 10.0.0.1:80   # a public name from the local authority\n"
"sibuna lb --tls auto --domain example.org --acme-on-demand-ask "
"http://127.0.0.1:9000/ok --server 10.0.0.1:80   # more names on demand\n"
"sibuna ctl /run/sibuna/edge.sock show certs                        # "
"certificates of tls.auto and on demand, and their OCSP staples\n"
"sibuna ctl /run/sibuna/edge.sock show ca > sibuna-root.crt         # the "
"root to install in clients\n"
"sibuna ctl /run/sibuna/edge.sock revoke cert db.corp.internal      # a "
"certificate of the local authority, or its serial\n"
"sibuna ctl /run/sibuna/edge.sock show hooks                        # "
"plugins: calls, verdicts, failures, open breakers (SID 0030)\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain   "
"# or ready\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 weight 5\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain "
"local   # this node only\n"
"sibuna ctl /run/sibuna/edge.sock del ban 203.0.113.9                      "
" # on every node of a mesh\n"
"sibuna ctl /run/sibuna/edge.sock reload cluster                           "
" # this node, then its peers\n"
"sibuna ctl /run/sibuna/edge.sock show cluster                             "
" # the file digest or revision of every node\n"
"sibuna ctl /run/sibuna/edge.sock show affinity                            "
" # the sticky table and the shares of fleet-wide limits\n"
"sibuna ctl /run/sibuna/edge.sock add server app/blue 10.0.0.3:80\n"
"sibuna ctl /run/sibuna/edge.sock del server app/blue\n"
"sibuna ctl /run/sibuna/edge.sock reload                            # as "
"SIGHUP, with the result\n"
"sibuna ctl /run/sibuna/edge.sock reopen log                        # "
"after logrotate renamed the access log\n"
"sibuna ctl /run/sibuna/edge.sock show info | grep spill            # the "
"disk tier of the sticky table: file, cost, counters\n"
"sibuna authority diff -c /etc/sibuna/node.json -f edge.jlv         # what "
"apply would change in the database\n"
"sibuna authority apply -c /etc/sibuna/node.json -f edge.jlv --expect 7 "
"--note \"add web3\"   # publish revision 8, or DBA002\n"
"sibuna authority history -c /etc/sibuna/node.json --limit 20       # the "
"revisions, newest first\n"
"sibuna authority rollback -c /etc/sibuna/node.json 6               # a "
"new revision with the document of 6\n"
"sibuna authority dump -c /etc/sibuna/node.json --revision 6        # "
"evaluated data; --source for the source\n"
"sibuna authority status -c /etc/sibuna/node.json                   # the "
"head and what every node applied\n"
"sibuna ctl /run/sibuna/edge.sock show authority                    # the "
"revision that this node serves\n"
"cat fullchain.pem privkey.pem > /etc/sibuna/certs/site.pem   # one "
"HAProxy-style bundle"
msgstr ""
"sibuna lb --bind :8080 --server 10.0.0.1:80 --server 10.0.0.2:80   # "
"ファイル不要\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --print-config > edge.jlv\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --firewall shield --health "
"/healthz --admin /run/sibuna/edge.sock --access-log stdout\n"
"sibuna lb --proto tcp --bind :2222 --server 10.0.0.8:22\n"
"sibuna lb --proto udp --bind 192.0.2.10:53 --server 10.0.0.53:53       # "
"UDPは特定のIPをバインド\n"
"sibuna lb --tls auto --domain example.org --server 10.0.0.1:80     # "
"自動HTTPS（ACME）\n"
"sibuna check -f edge.jlv           # またはedge.json：トポロジー、証明書、CAファイルを検証\n"
"sibuna --config-file edge.jlv      # TCP、UDP、HTTPのフロントエンドを提供\n"
"kill -HUP \"$(pidof sibuna)\"        # ルート、ポリシー、証明書をその場で再読み込み\n"
"sibuna ctl /run/sibuna/edge.sock show servers                      # "
"global.admin_socketが必要\n"
"sibuna ctl /run/sibuna/edge.sock show stats                        # "
"エッジのPrometheusテキスト\n"
"sibuna ctl /run/sibuna/edge.sock help                              # "
"すべてのコマンド\n"
"/opt/sibuna/new/sibuna --config-file edge.jlv   # "
"global.upgrade_socketがあれば、動いているデーモンを接続を失わずに置き換え（Linux）\n"
"sibuna lb --tls auto --domain localhost --server 10.0.0.1:80       # "
"同じことをローカルの認証局で\n"
"sibuna lb --tls auto --domain staging.example.org --acme-issuer internal "
"--server 10.0.0.1:80   # ローカルの認証局による公開の名前\n"
"sibuna lb --tls auto --domain example.org --acme-on-demand-ask "
"http://127.0.0.1:9000/ok --server 10.0.0.1:80   # オンデマンドで名前を追加\n"
"sibuna ctl /run/sibuna/edge.sock show certs                        # "
"tls.autoとオンデマンドの証明書と、そのOCSPステープル\n"
"sibuna ctl /run/sibuna/edge.sock show ca > sibuna-root.crt         # "
"クライアントにインストールするルート\n"
"sibuna ctl /run/sibuna/edge.sock revoke cert db.corp.internal      # "
"ローカルの認証局の証明書、またはそのシリアル\n"
"sibuna ctl /run/sibuna/edge.sock show hooks                        # "
"プラグイン：呼び出し、判定、失敗、開いたブレーカー（SID 0030）\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain   "
"# またはready\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 weight 5\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain "
"local   # このノードのみ\n"
"sibuna ctl /run/sibuna/edge.sock del ban 203.0.113.9                      "
" # メッシュのすべてのノードで\n"
"sibuna ctl /run/sibuna/edge.sock reload cluster                           "
" # このノード、次にそのピア\n"
"sibuna ctl /run/sibuna/edge.sock show cluster                             "
" # すべてのノードのファイルのダイジェストまたはリビジョン\n"
"sibuna ctl /run/sibuna/edge.sock show affinity                            "
" # スティッキーテーブルとフリート全体の上限の割り当て\n"
"sibuna ctl /run/sibuna/edge.sock add server app/blue 10.0.0.3:80\n"
"sibuna ctl /run/sibuna/edge.sock del server app/blue\n"
"sibuna ctl /run/sibuna/edge.sock reload                            # "
"SIGHUPと同じ、結果付き\n"
"sibuna ctl /run/sibuna/edge.sock reopen log                        # "
"logrotateがアクセスログの名前を変えた後\n"
"sibuna ctl /run/sibuna/edge.sock show info | grep spill            # "
"スティッキーテーブルのディスクの層：ファイル、コスト、カウンター\n"
"sibuna authority diff -c /etc/sibuna/node.json -f edge.jlv         # "
"applyがデータベースで変えるもの\n"
"sibuna authority apply -c /etc/sibuna/node.json -f edge.jlv --expect 7 "
"--note \"add web3\"   # リビジョン8を公開、またはDBA002\n"
"sibuna authority history -c /etc/sibuna/node.json --limit 20       # "
"リビジョン、新しい順\n"
"sibuna authority rollback -c /etc/sibuna/node.json 6               # "
"6の文書を持つ新しいリビジョン\n"
"sibuna authority dump -c /etc/sibuna/node.json --revision 6        # "
"評価したデータ。ソースには--source\n"
"sibuna authority status -c /etc/sibuna/node.json                   # "
"先頭と、各ノードが適用したもの\n"
"sibuna ctl /run/sibuna/edge.sock show authority                    # "
"このノードが処理しているリビジョン\n"
"cat fullchain.pem privkey.pem > /etc/sibuna/certs/site.pem   # "
"HAProxy形式のバンドル一つ"

#: ../../quick-reference.rst:87
msgid ""
"{\n"
"  \"http\": {\"surface\": \"shield\", \"rate_limit\": 100, "
"\"rate_window\": \"10s\", \"idle_timeout\": \"15s\"},\n"
"  \"frontends\": {\n"
"    \"web\": {\"proto\": \"http\", \"binds\": [\"0.0.0.0:443\"],\n"
"            \"tls\": {\"crt\": \"/etc/sibuna/certs/\", \"http3\": true},\n"
"            \"routes\": [{\"host\": \"api.example.org\", \"backend\": "
