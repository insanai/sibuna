msgstr "唯一の形式：1行に一つのJSONオブジェクト。"

#: ../../operations.rst:1599
msgid "``access_log.queue``"
msgstr "``access_log.queue``"

#: ../../operations.rst:1600
msgid "8192"
msgstr "8192"

#: ../../operations.rst:1601
