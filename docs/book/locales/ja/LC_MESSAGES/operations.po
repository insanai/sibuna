msgid "Restart"
msgstr "再起動"

#: ../../operations.rst:2240
msgid "``state drain``"
msgstr "``state drain``"

#: ../../operations.rst:2241
msgid ""
"Kept, while the file still has a server of that pool, name and address"
msgstr "ファイルにそのプール、名前、アドレスのサーバーがまだある間は保持"

#: ../../operations.rst:2242 ../../operations.rst:2246
msgid "Kept"
msgstr "保持"

