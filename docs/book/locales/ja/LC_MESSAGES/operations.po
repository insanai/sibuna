"                { name: \"b\", addr: \"10.20.0.9:22\", weight: 1, "
"max_flows: 50 },\n"
"            ] },\n"
"            nameservers: {\n"
"                mode: \"udp\", balance: { kind: \"bounded_maglev\" },\n"
"                servers: [\"10.20.0.53:53\"],\n"
"            },\n"
"        },\n"
"    }\n"
"}"
