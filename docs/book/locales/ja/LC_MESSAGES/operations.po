"fontsize=8.5, fillcolor=\"#eff6ff\", color=\"#1e40af\", penwidth=1.0, "
"margin=\"0.1,0.05\"];\n"
"  edge [color=\"#64748b\", fontname=\"Helvetica\", fontsize=7.5, "
"fontcolor=\"#475569\", arrowsize=0.6];\n"
"\n"
"  worker [label=\"Edge worker\\naccept, admission,\\nUDP mappings\"];\n"
"  relay [label=\"Relay threads\\n(epoll)\", fillcolor=\"#f0fdf4\", "
"color=\"#15803d\"];\n"
"  tls [label=\"TLS, HTTP/2, HTTP/3\\ntermination\", "
"fillcolor=\"#f5f3ff\", color=\"#6d28d9\"];\n"
"  fw [label=\"HTTP firewall\\ngate or shield\", fillcolor=\"#fffbeb\", "
