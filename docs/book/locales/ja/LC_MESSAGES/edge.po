"  relay [label=\"中継スレッド\\nバイトのパイプ\"];\n"
"  worker [label=\"HTTPワーカー\\nHTTP/1.1のTLS\", fillcolor=\"#f0fdf4\", "
"color=\"#15803d\"];\n"
