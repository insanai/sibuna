"    &self,\n"
"    challenge_id: &[u8],\n"
"    solution: Solution<'_>,\n"
"    client_ip: &[u8],\n"
"    user_agent: &[u8],\n"
"    now: u64,\n"
") -> Result<Verified, VerifyError> {\n"
