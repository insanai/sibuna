msgid "``--websocket-idle-timeout``"
msgstr "``--websocket-idle-timeout``"

#: ../../operations.rst:60 ../../operations.rst:93
msgid "``300``"
msgstr "``300``"

#: ../../operations.rst:61
msgid "Idle deadline of an upgraded connection in seconds, 0 to 86400"
msgstr "مهلة الخمول للاتصال المرقّى بالثواني، من 0 إلى 86400"

