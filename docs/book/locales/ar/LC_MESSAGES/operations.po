"        error_page 401 = @sibuna_challenge;\n"
"        error_page 500 = @sibuna_auth_error;\n"
"        proxy_http_version 1.1;\n"
"        proxy_set_header Upgrade $http_upgrade;\n"
"        proxy_set_header Connection $sibuna_connection_upgrade;\n"
