#: ../../../../../../home/insan/projects/sibuna/docs/book/algorithms.rst:91
msgid "Byte Classes in One Pass"
msgstr "एक पास में Byte Classes"

#: ../../../../../../home/insan/projects/sibuna/docs/book/algorithms.rst:94
msgid ""
"Each inspected field is scanned once to collect which byte classes occur: "
"quotes, ``=``, ``<``, shell separators, ``%``, NUL, canonicalisation "
"triggers, and double spaces. Every detector consults the classes instead "
"of rescanning, and the canonicalised second pass runs only when a trigger "
"was seen. The scan is a 256-entry table lookup per byte, from the WAF "
"module of ``sibuna-policy``. Four accumulators keep the OR chains short, "
"and the two byte pairs (``/*`` and two adjacent spaces) are searched for "
"only when no single byte has already demanded canonicalisation:"
msgstr ""
"जाँचे जाने वाले हर फ़ील्ड को एक बार स्कैन करके यह नोट किया जाता है कि "
"कौन-सी byte classes उसमें मौजूद हैं: quotes, ``=``, ``<``, shell "
"separators, ``%``, NUL, canonicalisation ट्रिगर और डबल स्पेस। हर "
"डिटेक्टर दोबारा स्कैन करने के बजाय इन्हीं क्लास को देखता है, और "
"canonicalised दूसरा पास तभी चलता है जब कोई ट्रिगर मिला हो। यह स्कैन "
"``sibuna-policy`` के WAF मॉड्यूल में प्रति बाइट 256-एंट्री टेबल लुकअप "
"है। चार accumulators OR चेन को छोटा रखते हैं, और दो बाइट पेयर (``/*`` "
"और दो लगातार स्पेस) तभी ढूँढे जाते हैं जब किसी अकेले बाइट ने पहले ही "
"canonicalisation की ज़रूरत न जता दी हो:"

#: ../../../../../../home/insan/projects/sibuna/docs/book/algorithms.rst:96
msgid ""
"pub(crate) fn scan(text: &[u8]) -> Classes {\n"
"    let (chunks, remainder) = text.as_chunks::<8>();\n"
"    // Four accumulators keep the OR chains short so the loads can issue "
"back to back.\n"
"    let mut lanes = [0u16; 4];\n"
"    for chunk in chunks {\n"
"        lanes[0] |= TABLE[usize::from(chunk[0])] | "
"TABLE[usize::from(chunk[4])];\n"
"        lanes[1] |= TABLE[usize::from(chunk[1])] | "
"TABLE[usize::from(chunk[5])];\n"
"        lanes[2] |= TABLE[usize::from(chunk[2])] | "
"TABLE[usize::from(chunk[6])];\n"
"        lanes[3] |= TABLE[usize::from(chunk[3])] | "
"TABLE[usize::from(chunk[7])];\n"
"    }\n"
"    let mut bits = lanes[0] | lanes[1] | lanes[2] | lanes[3];\n"
"    for &byte in remainder {\n"
"        bits |= TABLE[usize::from(byte)];\n"
"    }\n"
"    // The pairs matter only while no single byte has demanded "
"canonicalisation yet.\n"
"    if bits & CANONICAL == 0\n"
"        && ((bits & SPACE != 0 && has_pair(text, b' ', b' '))\n"
"            || (bits & (SLASH | STAR) == SLASH | STAR && has_pair(text, "
"b'/', b'*')))\n"
"    {\n"
"        bits |= CANONICAL;\n"
"    }\n"
"    Classes { bits }\n"
"}"
msgstr ""
"pub(crate) fn scan(text: &[u8]) -> Classes {\n"
"    let (chunks, remainder) = text.as_chunks::<8>();\n"
"    // चार accumulator OR चेन को छोटा रखते हैं ताकि लोड्स लगातार जारी हो सकें।\n"
"    let mut lanes = [0u16; 4];\n"
"    for chunk in chunks {\n"
"        lanes[0] |= TABLE[usize::from(chunk[0])] | TABLE[usize::from(chunk[4])];\n"
"        lanes[1] |= TABLE[usize::from(chunk[1])] | TABLE[usize::from(chunk[5])];\n"
"        lanes[2] |= TABLE[usize::from(chunk[2])] | TABLE[usize::from(chunk[6])];\n"
"        lanes[3] |= TABLE[usize::from(chunk[3])] | TABLE[usize::from(chunk[7])];\n"
"    }\n"
"    let mut bits = lanes[0] | lanes[1] | lanes[2] | lanes[3];\n"
"    for &byte in remainder {\n"
"        bits |= TABLE[usize::from(byte)];\n"
"    }\n"
"    // बाइट पेयर तभी मायने रखते हैं जब किसी अकेले बाइट ने पहले से canonicalisation न माँगा हो।\n"
"    if bits & CANONICAL == 0\n"
"        && ((bits & SPACE != 0 && has_pair(text, b' ', b' '))\n"
"            || (bits & (SLASH | STAR) == SLASH | STAR && has_pair(text, b'/', b'*')))\n"
"    {\n"
"        bits |= CANONICAL;\n"
"    }\n"
"    Classes { bits }\n"
"}"

