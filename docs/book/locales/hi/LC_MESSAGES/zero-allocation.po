"            return Ok(relayed.client_keep && buffered);\n"
"        }\n"
"        Err(error) => {\n"
"            drop(origin);\n"
"            let stale = was_pooled\n"
"                && retryable\n"
"                && matches!(\n"
"                    error,\n"
