#: ../../../../../../home/insan/projects/sibuna/docs/book/zero-allocation.rst:443
msgid ""
"fn insert(\n"
"    &mut self,\n"
"    tag: &Tag,\n"
"    expires_at: u64,\n"
"    now: u64,\n"
") -> Result<(), SpendError> {\n"
"    if !self.can_insert(tag, now) {\n"
"        return Err(SpendError::Full);\n"
"    }\n"
"    let mut carry = Entry { tag: *tag, expires_at, dist: 0 };\n"
"    let mut idx = Self::home(tag);\n"
"    while carry.dist < MAX_PROBE {\n"
"        let slot = &mut self.entries[idx];\n"
"        let Some(e) = slot else {\n"
"            *slot = Some(carry);\n"
"            return Ok(());\n"
"        };\n"
"        // Overwriting an expired occupant is safe only when the new "
"distance\n"
"        // is not smaller, so keys probing past this slot still pass the\n"
"        // early-termination test.\n"
"        if e.is_expired(now) && carry.dist >= e.dist {\n"
"            *e = carry;\n"
"            return Ok(());\n"
"        }\n"
"        if carry.dist > e.dist {\n"
"            std::mem::swap(&mut carry, e);\n"
"            // A displaced expired entry is simply dropped.\n"
"            if carry.is_expired(now) {\n"
"                return Ok(());\n"
"            }\n"
"        }\n"
"        idx = (idx + 1) % SHARD_CAPACITY;\n"
"        carry.dist += 1;\n"
"    }\n"
"    Err(SpendError::Full)\n"
"}"
msgstr ""
"fn insert(\n"
"    &mut self,\n"
"    tag: &Tag,\n"
"    expires_at: u64,\n"
"    now: u64,\n"
") -> Result<(), SpendError> {\n"
"    if !self.can_insert(tag, now) {\n"
"        return Err(SpendError::Full);\n"
"    }\n"
"    let mut carry = Entry { tag: *tag, expires_at, dist: 0 };\n"
"    let mut idx = Self::home(tag);\n"
"    while carry.dist < MAX_PROBE {\n"
"        let slot = &mut self.entries[idx];\n"
"        let Some(e) = slot else {\n"
"            *slot = Some(carry);\n"
"            return Ok(());\n"
"        };\n"
"        // एक्सपायर्ड ऑक्यूपेंट को ओवरराइट करना तभी सुरक्षित है जब नई दूरी\n"
"        // कम न हो, ताकि इस स्लॉट से आगे प्रोब करने वाली कीज़\n"
"        // अर्ली-टर्मिनेशन चेक फिर भी पास करें।\n"
"        if e.is_expired(now) && carry.dist >= e.dist {\n"
"            *e = carry;\n"
"            return Ok(());\n"
"        }\n"
"        if carry.dist > e.dist {\n"
"            std::mem::swap(&mut carry, e);\n"
"            // डिस्प्लेस हुई एक्सपायर्ड एंट्री बस ड्रॉप कर दी जाती है।\n"
"            if carry.is_expired(now) {\n"
"                return Ok(());\n"
"            }\n"
"        }\n"
"        idx = (idx + 1) % SHARD_CAPACITY;\n"
"        carry.dist += 1;\n"
"    }\n"
"    Err(SpendError::Full)\n"
"}"

#: ../../../../../../home/insan/projects/sibuna/docs/book/zero-allocation.rst:482
msgid ""
"The expired-slot rule is the subtle part: an expired entry may be "
"overwritten in place only by a key at least as far from its home, "
"otherwise a later key that probes past the slot would stop early and be "
"lost. Expired entries that get displaced are simply dropped. No sweeper "
"thread is needed. Insertion first simulates the displacement path without "
"changing anything (``can_insert``) and checks that bounded displacement "
"can succeed without losing a live tag."
msgstr "एक्सपायर्ड-स्लॉट वाला नियम इसका सबसे बारीक हिस्सा है: एक्सपायर हुई एंट्री को इन-प्लेस तभी ओवरराइट किया जा सकता है जब नई की अपने होम से कम से कम उतनी ही दूर हो, वरना उस स्लॉट से आगे प्रोब करने वाली बाद की कोई की जल्दी रुककर मिस हो जाएगी। डिस्प्लेस हुई एक्सपायर्ड एंट्रीज़ बस ड्रॉप कर दी जाती हैं। किसी स्वीपर थ्रेड की ज़रूरत नहीं। इन्सर्ट पहले कुछ बदले बिना डिस्प्लेसमेंट पाथ को सिमुलेट करता है (``can_insert``) और चेक करता है कि बाउंडेड डिस्प्लेसमेंट किसी लाइव टैग को खोए बिना पूरा हो सकता है।"

