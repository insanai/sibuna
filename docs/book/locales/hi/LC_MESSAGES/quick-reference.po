#: ../../quick-reference.rst:189
msgid ""
"{ \"default_action\": \"CHALLENGE\", \"waf\": true,\n"
"  \"thresholds\": {\"challenge_at\": 10, \"deny_at\": 40, \"bits_step\": "
"5},\n"
"  \"ip_rules\": {\"10.0.0.0/8\": \"ALLOW\", \"2001:db8::/32\": "
"\"DENY\"},\n"
"  \"rules\": [\n"
"    {\"name\": \"api\", \"path\": \"/api/*\", \"headers\": "
"{\"X-Api-Key\": \".*\"}, \"action\": \"ALLOW\"},\n"
"    {\"name\": \"checkout\", \"path\": \"/checkout/*\", \"action\": "
"\"CHALLENGE\",\n"
"     \"challenge\": {\"difficulty\": 20, \"algorithm\": \"posw\"}},\n"
"    {\"name\": \"login\", \"path\": \"^/login$\", \"action\": "
"\"CHALLENGE\",\n"
"     \"limits\": {\"rate\": 10, \"window_seconds\": 60, \"ban_seconds\": "
"600}},\n"
"    {\"name\": \"old-tls\", \"ja4\": \"t12*\", \"action\": "
"\"CHALLENGE\"},\n"
"    {\"name\": \"headless\", \"user_agent\": \"Headless\", \"action\": "
"\"WEIGH\", \"weight\": 30} ] }"
msgstr ""
"{ \"default_action\": \"CHALLENGE\", \"waf\": true,\n"
"  \"thresholds\": {\"challenge_at\": 10, \"deny_at\": 40, \"bits_step\": "
"5},\n"
"  \"ip_rules\": {\"10.0.0.0/8\": \"ALLOW\", \"2001:db8::/32\": "
"\"DENY\"},\n"
"  \"rules\": [\n"
"    {\"name\": \"api\", \"path\": \"/api/*\", \"headers\": "
"{\"X-Api-Key\": \".*\"}, \"action\": \"ALLOW\"},\n"
"    {\"name\": \"checkout\", \"path\": \"/checkout/*\", \"action\": "
"\"CHALLENGE\",\n"
"     \"challenge\": {\"difficulty\": 20, \"algorithm\": \"posw\"}},\n"
"    {\"name\": \"login\", \"path\": \"^/login$\", \"action\": "
"\"CHALLENGE\",\n"
"     \"limits\": {\"rate\": 10, \"window_seconds\": 60, \"ban_seconds\": "
"600}},\n"
"    {\"name\": \"old-tls\", \"ja4\": \"t12*\", \"action\": "
"\"CHALLENGE\"},\n"
"    {\"name\": \"headless\", \"user_agent\": \"Headless\", \"action\": "
"\"WEIGH\", \"weight\": 30} ] }"

#: ../../quick-reference.rst:203
msgid ""
"JA4: a whole fingerprint, or a prefix and ``*``; no fingerprint, no "
"match. Patterns: ``*`` or ``.*`` any; ``^...$`` exact; trailing ``*`` "
"prefix; leading ``/`` exact path; else case-insensitive substring. Paths "
"are matched in normal form. Order: WAF -> trie deny/allow -> rules -> "
"score -> bypass -> trie challenge -> bots -> default."
msgstr ""
"JA4: पूरा फ़िंगरप्रिंट, या प्रीफ़िक्स और ``*``; फ़िंगरप्रिंट नहीं, तो मेल "
"नहीं। पैटर्न: ``*`` या ``.*`` कुछ भी; ``^...$`` सटीक; अंत में ``*`` "
"प्रीफ़िक्स; शुरू में ``/`` सटीक पाथ; अन्यथा केस-असंवेदी सबस्ट्रिंग। पाथ "
"का मिलान सामान्य रूप (normal form) में होता है। क्रम: WAF -> trie "
"deny/allow -> नियम -> स्कोर -> बायपास -> trie challenge -> बॉट -> "
"डिफ़ॉल्ट।"

