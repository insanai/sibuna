#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:1
msgid "Part XIII: Quick Reference Card"
msgstr "भाग XIII: क्विक रेफ़रेंस कार्ड"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:4
msgid ""
"Keep beside a terminal: build, run, configure, route, observe, and "
"diagnose. Part XII holds the full tables; this card holds what an "
"operator types."
msgstr ""
"इसे टर्मिनल के पास रखें: बिल्ड, रन, कॉन्फ़िगर, रूट, मॉनिटर और डायग्नोज़ "
"करने के लिए। पूरी टेबलें भाग XII में हैं; इस कार्ड में वही है जो ऑपरेटर "
"टाइप करता है।"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:6
msgid "Build"
msgstr "बिल्ड"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:9
msgid ""
"cargo build --release -p sibuna                          # daemon + "
"SQLite + console + JLV + ACME\n"
"cargo build --release -p sibuna --no-default-features    # in-memory, no "
"external crate\n"
"cargo build --release -p sibuna --features postgres-tls  # shared "
"PostgreSQL clusters\n"
"rustup target add wasm32-unknown-unknown   # or set SIBUNA_POW_WASM / "
"SIBUNA_CONSOLE_WASM\n"
"cargo test            # unit, live daemon, storage and console tests\n"
"cargo clippy --all-targets && cargo fmt --check\n"
"cargo xtask check     # 70-line / 1,408-line / 99-column gate\n"
"cargo xtask browser   # headless Chromium checks\n"
"cargo xtask bench product   # whole products under wrk -> "
"benchmarks/results/\n"
"guidedog build        # this book (guidedog dsc: the SID records)"
msgstr ""
"cargo build --release -p sibuna                          # डेमन + SQLite + कंसोल + JLV + ACME\n"
"cargo build --release -p sibuna --no-default-features    # इन-मेमोरी, कोई बाहरी क्रेट नहीं\n"
"cargo build --release -p sibuna --features postgres-tls  # शेयर्ड PostgreSQL क्लस्टर\n"
"rustup target add wasm32-unknown-unknown   # या SIBUNA_POW_WASM / SIBUNA_CONSOLE_WASM सेट करें\n"
"cargo test            # यूनिट, लाइव डेमन, स्टोरेज और कंसोल टेस्ट\n"
"cargo clippy --all-targets && cargo fmt --check\n"
"cargo xtask check     # 70-लाइन / 1,408-लाइन / 99-कॉलम गेट\n"
"cargo xtask browser   # headless Chromium चेक\n"
"cargo xtask bench product   # wrk के तहत पूरे प्रॉडक्ट -> benchmarks/results/\n"
"guidedog build        # यह बुक (guidedog dsc: SID रिकॉर्ड)"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:22
msgid "Run"
msgstr "चलाना"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:25
msgid ""
"# Shield (default): PoW + WAF, proxy to :3000\n"
"sibuna -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Gate: PoW only\n"
"sibuna --gate -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Forward auth behind Nginx/Caddy (trusts X-Forwarded-For)\n"
"sibuna -m forward_auth --host 127.0.0.1 -p 8080 -s /etc/sibuna/secret\n"
"# Edge: persistent policies, reputation, forensics in <dir>/sibuna.db\n"
"sibuna -D /var/lib/sibuna -s /etc/sibuna/secret\n"
"# JA4 from a trusted ingress (Cloudflare's header; nginx module: x-ja4; "
"ATS: ja4)\n"
"sibuna --ja4-header cf-ja4 --trust-forwarded -p 8080 -u 3000 -s "
"/etc/sibuna/secret\n"
"# Cluster member: shared PostgreSQL, unique node id\n"
"sibuna --database-url-file /etc/sibuna/database-url --cluster-node 1 -s "
"/etc/sibuna/secret\n"
"head -c 32 /dev/urandom | xxd -p -c 64 > /etc/sibuna/secret"
msgstr ""
"# Shield (डिफ़ॉल्ट): PoW + WAF, :3000 पर प्रॉक्सी\n"
"sibuna -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Gate: सिर्फ़ PoW\n"
"sibuna --gate -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# Nginx/Caddy के पीछे forward auth (X-Forwarded-For पर भरोसा करता है)\n"
"sibuna -m forward_auth --host 127.0.0.1 -p 8080 -s /etc/sibuna/secret\n"
"# Edge: <dir>/sibuna.db में पर्सिस्टेंट पॉलिसी, रेप्युटेशन, फ़ॉरेंसिक\n"
"sibuna -D /var/lib/sibuna -s /etc/sibuna/secret\n"
"# ट्रस्टेड इनग्रेस से JA4 (Cloudflare का हेडर; nginx मॉड्यूल: x-ja4; ATS: ja4)\n"
"sibuna --ja4-header cf-ja4 --trust-forwarded -p 8080 -u 3000 -s /etc/sibuna/secret\n"
"# क्लस्टर मेंबर: शेयर्ड PostgreSQL, यूनिक नोड id\n"
"sibuna --database-url-file /etc/sibuna/database-url --cluster-node 1 -s /etc/sibuna/secret\n"
"head -c 32 /dev/urandom | xxd -p -c 64 > /etc/sibuna/secret"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:41
msgid "Edge load balancer"
msgstr "एज लोड बैलेंसर"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:44
msgid ""
"sibuna lb --bind :8080 --server 10.0.0.1:80 --server 10.0.0.2:80   # no "
"file needed\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --print-config > edge.jlv\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --firewall shield --health "
"/healthz --admin /run/sibuna/edge.sock --access-log stdout\n"
"sibuna lb --proto tcp --bind :2222 --server 10.0.0.8:22\n"
"sibuna lb --proto udp --bind 192.0.2.10:53 --server 10.0.0.53:53       # "
"UDP binds a specific IP\n"
"sibuna lb --tls auto --domain example.org --server 10.0.0.1:80     # "
"automatic HTTPS (ACME)\n"
"sibuna check -f edge.jlv           # or edge.json: validate topology, "
"certificates, CA files\n"
"sibuna --config-file edge.jlv      # serve TCP, UDP and HTTP frontends\n"
"kill -HUP \"$(pidof sibuna)\"        # reload routes, policy and "
"certificates in place\n"
"sibuna ctl /run/sibuna/edge.sock show servers                      # "
"needs global.admin_socket\n"
"sibuna ctl /run/sibuna/edge.sock show stats                        # the "
"Prometheus text of the edge\n"
"sibuna ctl /run/sibuna/edge.sock help                              # "
"every command\n"
"/opt/sibuna/new/sibuna --config-file edge.jlv   # with "
"global.upgrade_socket: replaces the running daemon, no connection lost "
"(Linux)\n"
"sibuna lb --tls auto --domain localhost --server 10.0.0.1:80       # the "
"same from the local authority\n"
"sibuna lb --tls auto --domain staging.example.org --acme-issuer internal "
"--server 10.0.0.1:80   # a public name from the local authority\n"
"sibuna lb --tls auto --domain example.org --acme-on-demand-ask "
"http://127.0.0.1:9000/ok --server 10.0.0.1:80   # more names on demand\n"
"sibuna ctl /run/sibuna/edge.sock show certs                        # "
"certificates of tls.auto and on demand, and their OCSP staples\n"
"sibuna ctl /run/sibuna/edge.sock show ca > sibuna-root.crt         # the "
"root to install in clients\n"
"sibuna ctl /run/sibuna/edge.sock revoke cert db.corp.internal      # a "
"certificate of the local authority, or its serial\n"
"sibuna ctl /run/sibuna/edge.sock show hooks                        # "
"plugins: calls, verdicts, failures, open breakers (SID 0030)\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain   "
"# or ready\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 weight 5\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain "
"local   # this node only\n"
"sibuna ctl /run/sibuna/edge.sock del ban 203.0.113.9                      "
" # on every node of a mesh\n"
"sibuna ctl /run/sibuna/edge.sock reload cluster                           "
" # this node, then its peers\n"
"sibuna ctl /run/sibuna/edge.sock show cluster                             "
" # the file digest or revision of every node\n"
"sibuna ctl /run/sibuna/edge.sock show affinity                            "
" # the sticky table and the shares of fleet-wide limits\n"
"sibuna ctl /run/sibuna/edge.sock add server app/blue 10.0.0.3:80\n"
"sibuna ctl /run/sibuna/edge.sock del server app/blue\n"
"sibuna ctl /run/sibuna/edge.sock reload                            # as "
"SIGHUP, with the result\n"
"sibuna ctl /run/sibuna/edge.sock reopen log                        # "
"after logrotate renamed the access log\n"
"sibuna ctl /run/sibuna/edge.sock show info | grep spill            # the "
"disk tier of the sticky table: file, cost, counters\n"
"sibuna authority diff -c /etc/sibuna/node.json -f edge.jlv         # what "
"apply would change in the database\n"
"sibuna authority apply -c /etc/sibuna/node.json -f edge.jlv --expect 7 "
"--note \"add web3\"   # publish revision 8, or DBA002\n"
"sibuna authority history -c /etc/sibuna/node.json --limit 20       # the "
"revisions, newest first\n"
"sibuna authority rollback -c /etc/sibuna/node.json 6               # a "
"new revision with the document of 6\n"
"sibuna authority dump -c /etc/sibuna/node.json --revision 6        # "
"evaluated data; --source for the source\n"
"sibuna authority status -c /etc/sibuna/node.json                   # the "
"head and what every node applied\n"
"sibuna ctl /run/sibuna/edge.sock show authority                    # the "
"revision that this node serves\n"
"cat fullchain.pem privkey.pem > /etc/sibuna/certs/site.pem   # one "
"HAProxy-style bundle"
msgstr ""
"sibuna lb --bind :8080 --server 10.0.0.1:80 --server 10.0.0.2:80   # किसी फ़ाइल की ज़रूरत नहीं\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --print-config > edge.jlv\n"
"sibuna lb --bind :8080 --server 10.0.0.1:80 --firewall shield --health /healthz --admin /run/sibuna/edge.sock --access-log stdout\n"
"sibuna lb --proto tcp --bind :2222 --server 10.0.0.8:22\n"
"sibuna lb --proto udp --bind 192.0.2.10:53 --server 10.0.0.53:53       # UDP एक खास IP पर बाइंड करता है\n"
"sibuna lb --tls auto --domain example.org --server 10.0.0.1:80     # ऑटोमैटिक HTTPS (ACME)\n"
"sibuna check -f edge.jlv           # या edge.json: टोपोलॉजी, सर्टिफ़िकेट और CA फ़ाइलें वेरिफ़ाई करें\n"
"sibuna --config-file edge.jlv      # TCP, UDP और HTTP फ़्रंटएंड सर्व करें\n"
"kill -HUP \"$(pidof sibuna)\"        # रूट, पॉलिसी और सर्टिफ़िकेट इन-प्लेस रीलोड करें\n"
"sibuna ctl /run/sibuna/edge.sock show servers                      # इसके लिए global.admin_socket चाहिए\n"
"sibuna ctl /run/sibuna/edge.sock show stats                        # एज का Prometheus टेक्स्ट\n"
"sibuna ctl /run/sibuna/edge.sock help                              # हर कमांड\n"
"/opt/sibuna/new/sibuna --config-file edge.jlv   # global.upgrade_socket के साथ: चल रहे डेमन को रिप्लेस करता है, बिना कोई कनेक्शन खोए (Linux)\n"
"sibuna lb --tls auto --domain localhost --server 10.0.0.1:80       # वही, लोकल अथॉरिटी से\n"
"sibuna lb --tls auto --domain staging.example.org --acme-issuer internal --server 10.0.0.1:80   # लोकल अथॉरिटी से एक पब्लिक नाम\n"
"sibuna lb --tls auto --domain example.org --acme-on-demand-ask http://127.0.0.1:9000/ok --server 10.0.0.1:80   # ऑन-डिमांड और नाम\n"
"sibuna ctl /run/sibuna/edge.sock show certs                        # tls.auto और ऑन-डिमांड सर्टिफ़िकेट, और उनके OCSP स्टेपल\n"
"sibuna ctl /run/sibuna/edge.sock show ca > sibuna-root.crt         # क्लाइंट्स में इंस्टॉल करने के लिए रूट CA\n"
"sibuna ctl /run/sibuna/edge.sock revoke cert db.corp.internal      # लोकल अथॉरिटी का सर्टिफ़िकेट, या उसका सीरियल\n"
"sibuna ctl /run/sibuna/edge.sock show hooks                        # प्लगइन: कॉल, वर्डिक्ट, फ़ेलियर, खुले ब्रेकर (SID 0030)\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain   # या ready\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 weight 5\n"
"sibuna ctl /run/sibuna/edge.sock set server app/10.0.0.1:80 state drain local   # सिर्फ़ यही नोड\n"
"sibuna ctl /run/sibuna/edge.sock del ban 203.0.113.9                       # मेश के हर नोड पर\n"
"sibuna ctl /run/sibuna/edge.sock reload cluster                            # पहले यह नोड, फिर इसके पीयर\n"
"sibuna ctl /run/sibuna/edge.sock show cluster                              # हर नोड का फ़ाइल डाइजेस्ट या रिविज़न\n"
"sibuna ctl /run/sibuna/edge.sock show affinity                             # स्टिकी टेबल और फ़्लीट-वाइड लिमिट के हिस्से\n"
"sibuna ctl /run/sibuna/edge.sock add server app/blue 10.0.0.3:80\n"
"sibuna ctl /run/sibuna/edge.sock del server app/blue\n"
"sibuna ctl /run/sibuna/edge.sock reload                            # SIGHUP जैसा ही, रिज़ल्ट के साथ\n"
"sibuna ctl /run/sibuna/edge.sock reopen log                        # logrotate द्वारा एक्सेस लॉग रीनेम करने के बाद\n"
"sibuna ctl /run/sibuna/edge.sock show info | grep spill            # स्टिकी टेबल का डिस्क टियर: फ़ाइल, कॉस्ट, काउंटर\n"
"sibuna authority diff -c /etc/sibuna/node.json -f edge.jlv         # apply डेटाबेस में क्या बदलेगा\n"
"sibuna authority apply -c /etc/sibuna/node.json -f edge.jlv --expect 7 --note \"add web3\"   # रिविज़न 8 पब्लिश करें, या DBA002\n"
"sibuna authority history -c /etc/sibuna/node.json --limit 20       # रिविज़न, सबसे नया पहले\n"
"sibuna authority rollback -c /etc/sibuna/node.json 6               # रिविज़न 6 के डॉक्यूमेंट के साथ नया रिविज़न\n"
"sibuna authority dump -c /etc/sibuna/node.json --revision 6        # इवैल्यूएट किया गया डेटा; सोर्स के लिए --source\n"
"sibuna authority status -c /etc/sibuna/node.json                   # head और हर नोड ने क्या अप्लाई किया\n"
"sibuna ctl /run/sibuna/edge.sock show authority                    # वह रिविज़न जो यह नोड सर्व कर रहा है\n"
"cat fullchain.pem privkey.pem > /etc/sibuna/certs/site.pem   # एक HAProxy-स्टाइल बंडल"

#: ../../../../../../home/insan/projects/sibuna/docs/book/quick-reference.rst:87
