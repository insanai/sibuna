"  relay -> tcp;\n"
"  worker -> udp [label=\"udp\"];\n"
"  worker -> tls [label=\"http + tls\"];\n"
"  worker -> fw [label=\"http\"];\n"
"  tls -> fw;\n"
"  fw -> route [label=\"admitted\"];\n"
"  worker -> route [style=dashed, label=\"firewall: false\"];\n"
"  route -> h1;\n"
