"}"

#: ../../operations.rst:2826
msgid "Request routing on the Shield surface"
msgstr "Shield सतह पर अनुरोध रूटिंग"

#: ../../operations.rst:2856
msgid ""
"sibuna --port 80 --upstream-host 127.0.0.1 --upstream-port 3000 \\\n"
"       --secret-file /etc/sibuna/secret --difficulty 16 --algorithm posw"
msgstr ""
