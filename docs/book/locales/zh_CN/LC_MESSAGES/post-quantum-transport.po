"        http: { policy_file: \"probe-policy.json\" },\n"
"        frontends: {\n"
"            web: {\n"
"                binds: [\"127.0.0.1:28443\"],\n"
"                tls: { crt: \"edge.pem\" },\n"
"                default_backend: \"app\",\n"
"            },\n"
"        },\n"
"        backends: {\n"
"            app: {\n"
"                http_version: \"1.1\",\n"
"                tls: { ca_file: \"ca.pem\", sni: \"origin.example.test\" },\n"
"                servers: [\"127.0.0.1:29443\"],\n"
"            },\n"
"        },\n"
"    }\n"
"}"
msgstr ""
"fn edge() -> Map<Value> {\n"
