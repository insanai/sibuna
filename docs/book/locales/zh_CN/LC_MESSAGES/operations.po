msgstr "``\"1.1\"``\\ （默认）"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1186
#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1195
msgid "absent"
msgstr "不设置"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1187
msgid "Cleartext HTTP/1.1 with keep-alive. No adapter is involved."
msgstr "带 keep-alive 的明文 HTTP/1.1。不涉及适配器。"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1188
