msgstr "``\"2\"``"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1193
msgid ""
"One HTTP/2 session per server, negotiated by ALPN. Each request is a "
"stream."
msgstr "每台服务器一个 HTTP/2 会话，通过 ALPN 协商。每个请求是一个流。"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1196
msgid "Cleartext HTTP/2 with prior knowledge (h2c)"
msgstr "预先知晓的明文 HTTP/2（h2c）"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1197
msgid "``\"3\"``"
msgstr "``\"3\"``"

