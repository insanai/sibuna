msgstr ""
"// operations.rst: the first and a later handshake for an on-demand "
"name.\n"
"#import \"style.typ\": *\n"
"#show: figure-frame.with(lang: \"zh_CN\")\n"
"\n"
"#sequence(\n"
"  (\n"
"    actor(\"client\", \"客户端\", kind: \"party\"),\n"
"    actor(\"sibuna\", \"Sibuna\", kind: \"accent\"),\n"
