"  (\n"
"    msg(\"client\", \"sibuna\", \"`shop.apps.example.org` 的 "
"ClientHello\"),\n"
"    act(\"sibuna\", \"防护规则允许该名称\"),\n"
"    msg(\"sibuna\", \"ca\", \"为该名称下单\", note: \"客户端等待，最多到配置的上限\"),\n"
