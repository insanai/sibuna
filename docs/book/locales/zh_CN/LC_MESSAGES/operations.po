msgstr "``http_version``"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1183
msgid "``tls``"
msgstr "``tls``"

#: ../../../../../../home/insan/projects/sibuna/docs/book/operations.rst:1184
