msgid "01 / Forward"
msgstr "01 / 転送"

msgid "02 / Terminate and route"
msgstr "02 / 終端とルーティング"

msgid "03 / Stay up"
msgstr "03 / 稼働を続ける"

msgid "04 / Scale out"
msgstr "04 / スケールアウト"

