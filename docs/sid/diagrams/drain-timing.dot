digraph drain_timing {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.28, ranksep=0.38];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#1e40af", fontname="Helvetica", fontsize=11, margin="0.13,0.08"];
  edge [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.75];
  signal [label="SIGTERM\nReadiness becomes 503"];
  delay [label="Serve new arrivals"];
  drain [label="Close admission\nFinish established flows"];
  exit [label="Close remaining flows and exit", fillcolor="#f1f5f9"];
  signal -> delay;
  delay -> drain [label=" global.drain_delay (default 0 s)"];
  drain -> exit [label=" once empty or at global.shutdown_timeout (default 5 s)"];
}
