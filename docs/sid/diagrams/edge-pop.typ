// SID 0015: an example edge deployment at a point of presence. ECMP spreads the flows
// over the hosts; each host has pinned packet workers, an optional spill service and a
// local control plane apart from them.
#import "style.typ": *
#show: figure-frame.with(lang: "en")

#flow(
  spacing: (4mm, 8mm),
  party((0.5, 0), "Legitimate clients", "TCP, UDP, HTTPS, QUIC", name: <clients>),
  party((2.2, 0), "Floods and botnets", "spoofed floods, scrapers", kind: "stop",
    name: <adversaries>),
  step((1.25, 1), "Edge transit or IXP", "BGP anycast VIPs,\nstateless five-tuple ECMP over the hosts",
    name: <transit>),
  step((0.5, 2), "NIC RSS, `SO_REUSEPORT`, cBPF", "SYN cookies, `TCP_DEFER_ACCEPT`",
    name: <kernel>),
  step((2, 2), "Co-resident OS", "BGP, SSH, ICMP", kind: "quiet", name: <os>),
  sibuna((0, 3), "Core 0 worker", "flow table, Maglev or P2C,\nUDP gate", name: <core0>),
  sibuna((1, 3), "Core 1 to N workers", "shared nothing,\nTLS SNI and JA4, GCRA", name: <coren>),
  step((0.5, 4), "`sibuna-kv`", "RAM cache, optional mmap spill", kind: "wait",
    name: <kv>),
  step((2, 3.5), "Local control plane", "JLV and JSON, RCU,\nhealth probes,\nSCM_RIGHTS, gossip",
    name: <control>),
  group((<kernel>, <os>, <core0>, <coren>, <kv>, <control>), kind: "accent", name: <host>),
  caption-node((2, 2.72), "Sibuna edge host i,\none of K in the PoP"),
  party((3.4, 2.4), "Sibling edge nodes", "heartbeats, stick tables,\none-hop forwarding",
    width: 34mm, name: <siblings>),
  store((3.4, 3.9), "Cluster control plane", "`sibuna.jlv`,\nPostgreSQL, `NOTIFY`",
    width: 34mm, name: <cluster>),
  party((0, 5.6), "TCP and TLS pool", "PROXY v2 with SNI and JA4", name: <tcp>),
  party((1, 5.6), "UDP and QUIC pool", "tuple or CID affinity", name: <udp>),
  party((2, 5.6), "HTTP/1.1 origins", "behind the gate or shield", name: <http>),
  edge(<clients>, <transit>, "-|>"),
  tone-edge("stop", <adversaries>, <transit>, "-|>"),
  main-edge(<transit>, <kernel>, "-|>", say("VIP flows"), label-side: right),
  edge(<kernel>, <core0>, "-|>"),
  edge(<kernel>, <coren>, "-|>"),
  edge(<core0>, <kv>, "-|>"),
  edge(<coren>, <kv>, "-|>"),
  edge(<control>, <coren>, "-|>", dash: "dashed"),
  edge(<host>, <siblings>, "<|-|>"),
  edge(<host>, <cluster>, "<|-|>"),
  main-edge(<host>, <tcp>, "-|>", say("L4 TCP"), label-side: right),
  main-edge(<host>, <udp>, "-|>", say("L4 UDP"), label-side: left),
  main-edge(<host>, <http>, "-|>", say("L7 HTTP"), label-side: left),
)
