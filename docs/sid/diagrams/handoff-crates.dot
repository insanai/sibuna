digraph handoff_crates {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.28, ranksep=0.38];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#1e40af", fontname="Helvetica", fontsize=11, margin="0.13,0.08"];
  edge [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.75];
  cmd [label="cmd/sibuna\nedge/upgrade.rs: old gate and replacement startup"];
  lb [label="crates/lb\nbind_inherited, lend_listeners, freeze_datagrams, lend_flows,\nresume_datagrams, adopt_flows, arm_streams, arm_datagrams,\nrelease_listeners, waker"];
  upgrade [label="crates/upgrade\nSocket, frames, protocol endpoints and FFI\nsendmsg, recvmsg, SO_PEERCRED, SO_TYPE, kill"];
  cmd -> lb -> upgrade;
}
