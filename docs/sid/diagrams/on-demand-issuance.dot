digraph on_demand {
  graph [bgcolor="white", pad=0.2, nodesep=0.26, ranksep=0.35];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#1e40af",
        fontname="Helvetica", fontsize=11];
  edge [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.75];

  subgraph cluster_tls {
    label="TLS handshake"; color="#cbd5e1";
    hello [label="Read ClientHello and name"];
    wait [label="Queue name and wait"];
    resume [label="Continue certificate selection"];
    hello -> resume [label=" already served or inadmissible"];
    hello -> wait [label=" admissible, no certificate"];
    wait -> resume [label=" wait limit reached", style=dashed];
  }
  subgraph cluster_acme {
    label="ACME thread"; color="#93c5fd";
    stored [label="Look in storage"];
    guards [label="Check ask policy and rate token"];
    install [label="Order or issue, then install"];
    wake [label="Wake waiters"];
    stored -> wake [label=" certificate loaded"];
    stored -> guards [label=" cache miss"];
    guards -> install [label=" permitted"];
    guards -> wake [label=" denied"];
    install -> wake;
  }
  wait -> stored [label=" request name"];
  wake -> resume [label=" if still waiting"];
}
