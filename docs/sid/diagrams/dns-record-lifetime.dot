digraph dns_record_lifetime {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.28, ranksep=0.38];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#1e40af", fontname="Helvetica", fontsize=11, margin="0.13,0.08"];
  edge [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.75];
  save [label="Save owner and value in presented file"];
  publish [label="Publish TXT through provider"]; wait [label="Wait for propagation"];
  check [label="Query all authoritative servers"]; respond [label="Respond to challenge"];
  cleanup [label="Remove TXT, then remove presented file"];
  save -> publish -> wait -> check; check -> respond [label=" all return the value"];
  check -> check [label=" poll until timeout"]; check -> cleanup [label=" timeout", style=dashed];
  respond -> cleanup [label=" order ends, success or failure"];
}
