digraph peer_forwarding {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.28, ranksep=0.38];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#1e40af", fontname="Helvetica", fontsize=11, margin="0.13,0.08"];
  edge [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.75];
  client [label="Client"]; receive [label="Node B\nCheck drain, rate and flow slot"];
  owner [label="Node A, eligible owner\nCheck roster, tag, epoch, frontend, drain,\nslot and rate for the original address"];
  relay [label="Relay client bytes both ways"]; serve [label="Serve using the client address in the header"];
  client -> receive [label=" TCP connect"];
  receive -> owner [label=" connect to forwarding port\n76-byte header"];
  owner -> relay [label=" 17-byte status: accepted"]; relay -> serve [dir=both];
}
