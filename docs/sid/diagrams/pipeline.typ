// SID 0006: the request pipeline and the part of the record that proves each stage.
#import "style.typ": *
#show: figure-frame.with(lang: "en")

#flow(
  spacing: (13mm, 6mm),
  data((0, 0), "Request", name: <request>),
  step((0, 1), "Parse", "zero copy", name: <parse>),
  step((0, 2), "Ban table", "Part E style, lock-free reads", name: <ban>),
  step((0, 3), "GCRA limiter", "Part D", name: <gcra>),
  step((0, 4), "Token check", "keyed BLAKE3 tag, Part C", name: <token-check>),
  decision((0, 5), "Policy", "automaton, tokenizer,\nrules; Part F", name: <policy>),
  outcome((-1, 5), "403", kind: "stop", name: <deny>),
  outcome((0, 6.3), "Proxy", name: <proxy>),
  step((1, 6), "Challenge id", "`payload || MAC`, Part C", kind: "wait", name: <challenge>),
  step((1, 7), "Solution", "hashcash (A) or PoSW (B)", name: <solution>),
  step((1, 8), "Verify", name: <verify>),
  step((1, 9), "Spent set", "Part E", name: <spent>),
  outcome((1, 10), "Token", "Part C", name: <token>),
  step((1, 0), "Engine slots", "swapped by RCU, Part G", kind: "quiet", name: <rcu>),
  step((2, 0), "Difficulty", "from load, Part H", kind: "quiet", name: <adaptive>),
  step((1, 1.3), "Incidents", kind: "quiet", name: <incidents>),
  step((2, 1.3), "Ring", kind: "quiet", name: <ring>),
  step((2, 2.6), "Storage", kind: "quiet", name: <storage>),
  step((1, 2.6), "Campaigns", "by embedding, Part I", kind: "quiet", name: <campaigns>),
  group((<rcu>, <adaptive>, <incidents>, <ring>, <storage>, <campaigns>), name: <bg>),
  caption-node((1.5, 3.4), "Background"),
  edge(<request>, <parse>, "-|>"),
  edge(<parse>, <ban>, "-|>"),
  edge(<ban>, <gcra>, "-|>"),
  edge(<gcra>, <token-check>, "-|>"),
  edge(<token-check>, <policy>, "-|>"),
  tone-edge("stop", <policy>, <deny>, "-|>", say-in("stop", "deny"), label-side: right),
  main-edge(<policy>, <proxy>, "-|>", say-in("good", "allow"), label-side: right),
  tone-edge("wait", <policy>, <challenge>, "-|>", say-in("wait", "challenge"),
    label-side: left),
  edge(<challenge>, <solution>, "-|>"),
  edge(<solution>, <verify>, "-|>"),
  edge(<verify>, <spent>, "-|>"),
  main-edge(<spent>, <token>, "-|>"),
  edge(<incidents>, <ring>, "-|>"),
  edge(<ring>, <storage>, "-|>"),
  edge(<storage>, <campaigns>, "-|>"),
)
