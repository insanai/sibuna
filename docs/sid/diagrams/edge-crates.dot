digraph edge_crates {
  graph [rankdir=TB, bgcolor="transparent", newrank=true, nodesep=0.12, ranksep=0.42, pad=0.1, fontname="Noto Sans", fontsize=9, fontcolor="#55665e"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=9.5, fontcolor="#20352f", color="#6a7c73", fillcolor="#fffffc", penwidth=0.9, height=0.32, margin="0.17,0.05"];
  edge [color="#6a7c73", arrowsize=0.55, penwidth=0.9];

  daemon [label=<cmd/sibuna<BR/><FONT POINT-SIZE="8" COLOR="#55665e">edge LB, WAF and console</FONT>>, color="#176a4b", fillcolor="#e7eee4", fontcolor="#0c402c", penwidth=1.4];
  console [label="sibuna-console"];
  net [label="sibuna-net"];
  jlv [label=<sibuna-jlv<BR/><FONT POINT-SIZE="8" COLOR="#55665e">off-path JLV/2<BR/>transform</FONT>>, color="#8f5512", fillcolor="#fbf4e4"];
  cluster [label=<sibuna-cluster<BR/><FONT POINT-SIZE="8" COLOR="#55665e">ATDP, SWIM,<BR/>CRDT, CPF</FONT>>, color="#8f5512", fillcolor="#fbf4e4"];
  storage [label=<sibuna-storage<BR/><FONT POINT-SIZE="8" COLOR="#55665e">SQLite or<BR/>PostgreSQL</FONT>>, color="#8f5512", fillcolor="#fbf4e4", shape=cylinder, style=filled];
  policy [label="sibuna-policy"];
  core [label="sibuna-core"];

  subgraph cluster_reusable {
    label="worker and schema crates"; labelloc=b; labeljust=r; style="dashed,rounded,filled"; color="#c3cec0"; fillcolor="#f7f6f1"; margin=8;
    node [color="#176a4b"];
    io [label=<sibuna-io<BR/><FONT POINT-SIZE="8" COLOR="#55665e">epoll, io_uring,<BR/>kqueue, IOCP</FONT>>];
    kv [label=<sibuna-kv<BR/><FONT POINT-SIZE="8" COLOR="#55665e">worker RAM,<BR/>off-path mmap</FONT>>];
    lb [label=<sibuna-lb<BR/><FONT POINT-SIZE="8" COLOR="#55665e">Maglev, P2C,<BR/>PROXY v2, SNI, JA4</FONT>>];
    conf [label=<sibuna-conf<BR/><FONT POINT-SIZE="8" COLOR="#55665e">EdgeConfig<BR/>schema, JSON</FONT>>];
    plugin [label=<sibuna-plugin<BR/><FONT POINT-SIZE="8" COLOR="#55665e">traits, fuel WASM,<BR/>SPOE</FONT>>];
    node [color="#6a7c73"];
    crypto [label="sibuna-crypto"];
    cidr [label="sibuna-cidr"];
    store [label="sibuna-store"];
    http [label="sibuna-http"];
  }

  { rank=same; console; net; }
  { rank=same; storage; cluster; jlv; }
  { rank=same; policy; conf; lb; kv; io; plugin; }
  { rank=same; core; cidr; crypto; http; store; }

  daemon -> net [color="#176a4b", penwidth=1.2]; daemon -> cluster [color="#176a4b", penwidth=1.2];
  daemon -> kv [color="#176a4b", penwidth=1.2]; daemon -> conf [color="#176a4b", penwidth=1.2];
  daemon -> jlv [color="#176a4b", penwidth=1.2]; daemon -> plugin [color="#176a4b", penwidth=1.2];
  daemon -> policy [color="#176a4b", penwidth=1.2]; daemon -> storage [color="#176a4b", penwidth=1.2];
  daemon -> console [color="#176a4b", penwidth=1.2];
  console -> storage; console -> cluster; console -> jlv;
  storage -> conf; storage -> policy; storage -> core;
  cluster -> lb; cluster -> kv; cluster -> crypto; cluster -> core;
  net -> io; net -> lb; net -> http; net -> core;
  jlv -> conf;
  policy -> core; policy -> cidr;
  plugin -> http; plugin -> crypto;
  conf -> cidr;
  lb -> crypto; lb -> cidr;
  kv -> crypto;
}
