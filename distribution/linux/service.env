# Settings of the packaged sibuna.service. No shell commands or secrets belong here.
# The origin must be an IP literal. The proxy listens on loopback until changed here.
SIBUNA_HOST=127.0.0.1
SIBUNA_PORT=8080
SIBUNA_UPSTREAM_HOST=127.0.0.1
SIBUNA_UPSTREAM_PORT=3000
# Further options, split at spaces, for example:
# SIBUNA_OPTIONS=--mode forward_auth --console 127.0.0.1:19446
SIBUNA_OPTIONS=
